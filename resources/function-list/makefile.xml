<?xml version='1.0' encoding='utf-8'?>
<NotepadPlus>
  <functionList>
    
    <parser displayName="Makefile" id="makefile" commentExpr="(?m-s:[#].*$)">
      <function mainExpr="^[\w\$\(\)\-\/\.]+:">
        <functionName>
          <nameExpr expr="[\w\$\(\)\-\/\.]+" />
        </functionName>
      </function>
    </parser>
  </functionList>
</NotepadPlus>