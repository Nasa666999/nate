{
  "version": 1,
  "lineLength": 110,
  "indentation": { "spaces": 4 },
  "maximumBlankLines": 1,
  "lineBreakBeforeControlFlowKeywords": true,
  "lineBreakBeforeEachArgument": true,
  "rules": {
    "UseSingleLinePropertyGetter": false,
    "NeverForceUnwrap": true,
    "NeverUseForceTry": true
  }
}
